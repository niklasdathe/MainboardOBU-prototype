menu "BicycleOBU LoRaWAN uplink"

config OBU_LORAWAN_ENABLE
    bool "Enable Wio-SX1262 LoRaWAN uplink"
    default n
    help
        Enable the Seeed XIAO ESP32-S3 + Wio-SX1262 B2B radio as a
        best-effort LoRaWAN uplink for received raw C-ITS frames. The device
        sends binary fragments to a LoRaWAN network server; a server-side
        bridge reassembles them and publishes the original frame to
        OpenTrafficMap MQTT.

config OBU_LORAWAN_JOIN_EUI
    string "LoRaWAN JoinEUI (16 hex digits)"
    depends on OBU_LORAWAN_ENABLE
    default "0000000000000000"

config OBU_LORAWAN_DEV_EUI
    string "LoRaWAN DevEUI (16 hex digits)"
    depends on OBU_LORAWAN_ENABLE
    default ""

config OBU_LORAWAN_NWK_KEY
    string "LoRaWAN NwkKey (32 hex digits)"
    depends on OBU_LORAWAN_ENABLE
    default ""

config OBU_LORAWAN_APP_KEY
    string "LoRaWAN AppKey (32 hex digits)"
    depends on OBU_LORAWAN_ENABLE
    default ""

config OBU_LORAWAN_FPORT
    int "Raw-frame fragment FPort"
    depends on OBU_LORAWAN_ENABLE
    range 1 223
    default 10

config OBU_LORAWAN_MAX_FRAME_BYTES
    int "Maximum raw C-ITS frame forwarded over LoRaWAN"
    depends on OBU_LORAWAN_ENABLE
    range 64 512
    default 512
    help
        Larger 802.11p frames are dropped rather than truncated. OpenTrafficMap
        must receive the original frame bytes intact.

config OBU_LORAWAN_FRAGMENT_DATA_BYTES
    int "Raw bytes per LoRaWAN fragment"
    depends on OBU_LORAWAN_ENABLE
    range 8 32
    default 32
    help
        The BicycleOBU fragment header is 12 bytes. A 32-byte data fragment
        therefore creates a 44-byte LoRaWAN application payload, conservative
        enough for low EU868 data rates.

config OBU_LORAWAN_QUEUE_DEPTH
    int "Pending raw-frame queue depth"
    depends on OBU_LORAWAN_ENABLE
    range 1 8
    default 4

config OBU_LORAWAN_MIN_FRAGMENT_INTERVAL_MS
    int "Minimum delay between fragment uplinks (ms)"
    depends on OBU_LORAWAN_ENABLE
    range 1000 600000
    default 10000
    help
        This is an additional application-side throttle. RadioLib LoRaWAN duty
        cycle handling remains enabled and is the authoritative regulatory gate.

config OBU_LORAWAN_JOIN_RETRY_MS
    int "Delay between OTAA join retries (ms)"
    depends on OBU_LORAWAN_ENABLE
    range 5000 600000
    default 60000

endmenu
