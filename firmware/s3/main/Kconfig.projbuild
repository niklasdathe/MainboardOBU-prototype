menu "BicycleOBU prototype"

config OBU_BUZZER_ENABLE
    bool "Enable Expansion Base local warning buzzer"
    default y
    help
        Enable the passive buzzer on the XIAO Expansion Base A3/D3 pin as a
        local warning output. The output is independent of the phone and OLED.

config OBU_BUZZER_DEFAULT_MUTED
    bool "Start local warning buzzer muted"
    depends on OBU_BUZZER_ENABLE
    default n
    help
        Start with audible warning output muted. Runtime control can later
        change this state through the authenticated control-plane interface.

config OBU_BUZZER_FREQUENCY_HZ
    int "Warning buzzer frequency (Hz)"
    depends on OBU_BUZZER_ENABLE
    range 100 10000
    default 2200

config OBU_BUZZER_DURATION_MS
    int "Warning buzzer pulse duration (ms)"
    depends on OBU_BUZZER_ENABLE
    range 20 1000
    default 120

config OBU_OTM_DIRECT_ENABLE
    bool "Enable direct OpenTrafficMap Wi-Fi uploader"
    default n

config OBU_WIFI_DEBUG
    bool "Enable Wi-Fi debug diagnostics"
    depends on OBU_OTM_DIRECT_ENABLE
    default n
    help
        Enable additional development diagnostics for the S3 Wi-Fi uplink.
        The firmware logs Wi-Fi driver/netif debug output, the effective STA
        configuration, association details, disconnect reason names and the
        DHCP/IP transition without printing the configured Wi-Fi password.
        This option does not intentionally change connection policy and should
        normally remain disabled outside troubleshooting sessions.

config OBU_OTM_TLS_TRACE
    bool "Enable verbose OpenTrafficMap TLS handshake tracing"
    depends on OBU_OTM_DIRECT_ENABLE
    default y
    select MBEDTLS_DEBUG
    help
        Enable ESP-IDF/mbedTLS internal TLS handshake tracing while diagnosing
        OpenTrafficMap broker connection failures. ESP-TLS automatically hooks
        the mbedTLS debug callback when MBEDTLS_DEBUG is selected. This is noisy
        development instrumentation and should be disabled after the broker
        connection problem has been resolved.

config OBU_WIFI_SSID
    string "Development Wi-Fi SSID"
    default ""

config OBU_WIFI_PASSWORD
    string "Development Wi-Fi password"
    default ""

config OBU_OTM_NODE_ID
    string "OpenTrafficMap node id"
    default "bicycleobu-prototype"

endmenu
