CONFIG_OBU_LORAWAN_ENABLE=y
CONFIG_OBU_LORAWAN_JOIN_EUI="0000000000000000"
CONFIG_OBU_LORAWAN_DEV_EUI="0011223344556677"
CONFIG_OBU_LORAWAN_NWK_KEY="000102030405060708090A0B0C0D0E0F"
CONFIG_OBU_LORAWAN_APP_KEY="0F0E0D0C0B0A09080706050403020100"
CONFIG_OBU_LORAWAN_JOIN_DATARATE=3
# Maximum-throughput application profile: fixed DR5, full legal fragment payload,
# no artificial application-side delay. RadioLib duty-cycle handling stays on.
# CONFIG_OBU_LORAWAN_ADR_ENABLE is not set
CONFIG_OBU_LORAWAN_UPLINK_DATARATE=5
CONFIG_OBU_LORAWAN_FRAGMENT_DATA_BYTES=230
CONFIG_OBU_LORAWAN_MIN_FRAGMENT_INTERVAL_MS=0
CONFIG_OBU_LORAWAN_DEBUG=y
CONFIG_OBU_LORAWAN_RADIOLIB_PROTOCOL_DEBUG=y
# Full SPI tracing is intentionally left off in CI; it is a short-capture diagnostic only.
# CONFIG_OBU_LORAWAN_RADIOLIB_SPI_DEBUG is not set
CONFIG_OBU_GNSS_PPS_GPIO=47
