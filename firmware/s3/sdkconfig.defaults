# Seeed Studio XIAO ESP32-S3 prototype hardware: 8 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# app_main performs I2C/RTC, SPI IPC, GNSS, SD, HMI and warning setup before
# remaining alive as the S3 IPC receive loop. Keep conservative stack headroom.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# RadioLib's native ESP-IDF LoRaWAN HAL requires millisecond scheduler
# resolution so the Class A RX1/RX2 windows can be opened reliably.
CONFIG_FREERTOS_HZ=1000

# Maximum-throughput LoRaWAN application defaults. OTAA uses its separate join
# data rate. Regulatory EU868 duty-cycle handling remains enabled in RadioLib.
# CONFIG_OBU_LORAWAN_ADR_ENABLE is not set
CONFIG_OBU_LORAWAN_UPLINK_DATARATE=5
CONFIG_OBU_LORAWAN_FRAGMENT_DATA_BYTES=230
CONFIG_OBU_LORAWAN_MIN_FRAGMENT_INTERVAL_MS=0

# The S3 hub links FAT/SD, GNSS/time, HMI and warning drivers. Keep the larger
# single-app development layout for prototype growth; OTA is intentionally not
# implemented in this prototype firmware yet.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
