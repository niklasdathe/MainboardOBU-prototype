# Seeed Studio XIAO ESP32-S3 prototype hardware: 8 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# app_main performs I2C/RTC, SPI IPC, GNSS, SD, HMI and warning setup before
# remaining alive as the S3 IPC receive loop. Keep conservative stack headroom.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# The S3 hub links FAT/SD, GNSS/time, HMI and warning drivers. Keep the larger
# single-app development layout for prototype growth; OTA is intentionally not
# implemented in this prototype firmware yet.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
